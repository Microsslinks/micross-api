# =============================================================================
#  MicrossAPI / Microsslink 微观互联 — backend-only dev image
#  Repository: https://github.com/microsslinks/micross-api
#
#  This Dockerfile builds the Go backend from THIS repository WITHOUT bundling
#  the frontend. A placeholder `web/dist/index.html` is generated so the
#  //go:embed directive in main.go compiles cleanly. Pair this image with a
#  separate Rsbuild dev server (`make dev-web`) for hot-reloading the UI.
#
#  Use case: docker compose -f docker-compose.dev.yml up
#  Upstream Go module path is preserved per AGPLv3 §7 attribution (see
#  README.zh_CN.md → "我们信任的合作伙伴").
#
#  The produced image tag is `micross-api-dev:local` (set by docker-compose.dev.yml).
# =============================================================================

FROM golang:1.26.1-alpine AS builder

ENV GO111MODULE=on CGO_ENABLED=0
ARG TARGETOS
ARG TARGETARCH
ENV GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64}
ENV GOEXPERIMENT=greenteagc

# Build-time metadata (informational; only common.Version is actually injected)
ARG VERSION=dev
ARG GIT_COMMIT=unknown
ARG BUILD_TIME=unknown

WORKDIR /build

ADD go.mod go.sum ./
# relaykit is a local submodule referenced via replace; its go.mod must be
# present for go mod download to resolve the main module graph.
ADD relaykit/go.mod ./relaykit/go.mod
RUN go mod download

COPY . .

# Placeholder so //go:embed web/dist in main.go finds a non-empty target tree
RUN mkdir -p web/dist && \
    echo '<!doctype html><html><head><title>dev</title></head><body>use frontend dev server</body></html>' > web/dist/index.html

RUN go build \
    -ldflags "-s -w -X 'github.com/QuantumNous/new-api/common.Version=${VERSION}'" \
    -o micross-api

FROM debian:bookworm-slim

# Re-declare ARG for this stage (ARG scope is per-stage in multi-stage builds)
ARG VERSION=dev
ARG GIT_COMMIT=unknown
ARG BUILD_TIME=unknown

# OCI image metadata
LABEL org.opencontainers.image.title="MicrossAPI (dev backend)" \
      org.opencontainers.image.description="MicrossAPI 后端开发镜像 —— 不打包前端，与 Rsbuild dev server 配合使用" \
      org.opencontainers.image.source="https://github.com/microsslinks/micross-api" \
      org.opencontainers.image.url="https://github.com/microsslinks/micross-api" \
      org.opencontainers.image.documentation="https://github.com/microsslinks/micross-api/blob/main/docker-compose.dev.yml" \
      org.opencontainers.image.vendor="MicrossAPI / Microsslink 微观互联" \
      org.opencontainers.image.licenses="AGPL-3.0" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.created="${BUILD_TIME}" \
      org.opencontainers.image.authors="dukaworks"

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata wget \
    && rm -rf /var/lib/apt/lists/* \
    && update-ca-certificates

COPY --from=builder /build/micross-api /
COPY LICENSE NOTICE THIRD-PARTY-LICENSES.md /licenses/
EXPOSE 3000
WORKDIR /data
ENTRYPOINT ["/micross-api"]