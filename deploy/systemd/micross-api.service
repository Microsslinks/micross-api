# File path: /etc/systemd/system/micross-api.service
# sudo systemctl daemon-reload
# sudo systemctl start micross-api
# sudo systemctl enable micross-api
# sudo systemctl status micross-api
[Unit]
Description=MicrossAPI Service
After=network.target

[Service]
User=ubuntu  # 注意修改用户名
WorkingDirectory=/path/to/micross-api  # 注意修改路径
ExecStart=/path/to/micross-api/micross-api --port 3000 --log-dir /path/to/micross-api/logs  # 注意修改路径和端口号
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target